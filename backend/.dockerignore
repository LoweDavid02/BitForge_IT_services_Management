# Git
.git
.gitignore
.gitattributes

# Environment files — injected at runtime via Render env vars
.env
.env.*
!.env.example

# Dev-only
node_modules
npm-debug.log

# Tests — not needed in production image
tests
phpunit.xml
.phpunit.cache

# Laravel dev tools
storage/logs/*.log
storage/framework/cache/**
storage/framework/sessions/**
storage/framework/views/**
bootstrap/cache/*.php

# SQLite dev database — using MySQL in production
database/database.sqlite

# IDE + OS files
.idea
.vscode
*.DS_Store
Thumbs.db

# Docker build files themselves (already in image context)
Dockerfile
docker/

# ─────────────────────────────────────────────────────────────────────────────
# BitForge Backend — Environment Variables Reference
# Copy this to .env for local dev. Set these as Render env vars for production.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=BitForge
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-service.onrender.com
FRONTEND_URL=https://your-app.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
# Use stderr in Docker so Render captures logs automatically
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ── Database — Supabase managed PostgreSQL ───────────────────────────────────
# Get these from: Supabase Dashboard → Project → Settings → Database
# Use the "Connection pooling" (port 6543) URL for production to avoid
# exhausting direct connections under load.
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxx.supabase.co        # Session pooler host
DB_PORT=5432                                # Direct: 5432 | Pooler: 6543
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password
DB_SCHEMA=public
# Alternatively, paste the full connection string:
# DB_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# ── Cache / Session / Queue ──────────────────────────────────────────────────
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=your-service.onrender.com
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ── Sanctum ──────────────────────────────────────────────────────────────────
# Comma-separated list of domains that can use Bearer token auth
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app,localhost:5173

# ── Mail (optional — configure if you add email notifications) ───────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@bitforge.io"
MAIL_FROM_NAME="${APP_NAME}"

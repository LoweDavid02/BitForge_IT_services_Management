# ─────────────────────────────────────────────────────────────────────────────
# BitForge Backend — Environment Variables Reference
# Copy this to .env for local dev. Set these as Render env vars for production.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=BitForge
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-service.onrender.com
FRONTEND_URL=https://your-app.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
# Use stderr in Docker so Render captures logs automatically
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ── Database — Supabase managed PostgreSQL ───────────────────────────────────
# Paste the full connection string from:
# Supabase Dashboard → Project Settings → Database → Connection string → URI
#
# Format:  postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres
# Add ?sslmode=require at the end — Supabase requires SSL.
DB_CONNECTION=pgsql
DB_URL=postgresql://postgres:your-password@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require

# ── Cache / Session / Queue ──────────────────────────────────────────────────
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=your-service.onrender.com
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ── Sanctum ──────────────────────────────────────────────────────────────────
# Comma-separated list of domains that can use Bearer token auth
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app,localhost:5173

# ── Mail (optional — configure if you add email notifications) ───────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@bitforge.io"
MAIL_FROM_NAME="${APP_NAME}"
